<Window x:Class="FileProgressing2026.Document_ChildWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileProgressing2026"
        mc:Ignorable="d"
        Title="Document_ChildWindow" Height="200" Width="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        
        >
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="0" GlassFrameThickness="0" ></shell:WindowChrome>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Border x:Name="Bg" Background="#434343" Width="300" Height="200" CornerRadius="5">
            <StackPanel Orientation="Vertical" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="20,20,20,20">
                <Button x:Name="Button1" Content="sth" Background="#434343" BorderThickness="0" Foreground="White" Click="Button1_Click"></Button>
                <Button x:Name="Button2" Content="sth" Background="#434343" BorderThickness="0" Foreground="White" Margin="0,10,0,0" Click="Button2_Click"></Button>
                <Button x:Name="Button3" Content="sth" Background="#434343" BorderThickness="0" Foreground="White" Margin="0,10,0,0" Click="Button3_Click"></Button>
                <Button x:Name="Button4" Content="sth" Background="#434343" BorderThickness="0" Foreground="White" Margin="0,10,0,0" Click="Button4_Click"></Button>
            </StackPanel>
        </Border>
        
        
    </Grid>
</Window>
