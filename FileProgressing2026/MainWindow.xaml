<Window x:Class="FileProgressing2026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileProgressing2026"
        mc:Ignorable="d"
        Title="File Progressing 2026" Height="700" Width="1200"
        WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" ResizeBorderThickness="5"></shell:WindowChrome>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"></ColumnDefinition>
            <ColumnDefinition Width="300"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>

        </Grid.RowDefinitions>
        <Border Grid.ColumnSpan="3" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#232425" MouseLeftButtonDown="Border_MouseLeftButtonDown"></Border>
        <Border  Grid.Column="1" Grid.Row="1"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#2D2D2D">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Vertical" Grid.RowSpan="3" Grid.Row="0">

                    <Image Source="/Document.png" Grid.Row="0" Width="30" Height="30" HorizontalAlignment="Left" Margin="15,10,0,0"></Image>
                    <TextBlock Text="文件资源管理器" Grid.Row="1" Foreground="White" FontSize="12" Margin="20,0,0,0"></TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="20,10,0,0">
                        <Button x:Name="SelectAll" Height="20" Width="20" Background="#434343" Foreground="White" BorderThickness="0"  HorizontalAlignment="Left" Click="SelectAll_Click" Tag="0"></Button>
                        <TextBlock Text="全选" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0"></TextBlock>
                    </StackPanel>
                    
                </StackPanel>
                <ScrollViewer HorizontalAlignment="Stretch" Grid.Row="2" Margin="0,20,0,0">
                    <StackPanel x:Name="DocumentShower" x:FieldModifier="public" Orientation="Vertical"></StackPanel>
                </ScrollViewer>
            </Grid>
            
        </Border>
        <Border x:Name="Bg" Grid.Column="0" Grid.Row="1"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#434343"  >
            <StackPanel Margin="0,10,0,10">
                <TextBlock Text="通用" Foreground="White" FontSize="8" HorizontalAlignment="Center"></TextBlock>
                <Button x:Name="Rename" Content="📝" Foreground="White" FontSize="15" Padding="0,0,0,0" FontFamily="Segoe UI Emoji" Height="40" Width="40" BorderThickness="0" Background="#232425" ToolTip="一键重命名已选择的文件(模板详见请点击)" Margin="0,10,0,0" Click="Rename_Click"></Button>
                <Button x:Name="ModifyExtension" Content="🏷" Foreground="White" FontSize="15" Padding="0,0,0,0" Height="40" Width="40" BorderThickness="0" Background="#232425" ToolTip="一键修改已选择的文件后缀(模板详见请点击)" Click="ModifyExtension_Click" Margin="0,10,0,0"></Button>
                <Button x:Name="Orangnize" Content="🧹 " Foreground="White" FontSize="15" Padding="5,0,0,0" Height="40" Width="40" BorderThickness="0" Background="#232425" ToolTip="整理文件,自动/自定义分类为文件夹" Click="Orangnize_Click" Margin="0,10,0,0"></Button>
                <TextBlock Text="文本文件" Foreground="White" FontSize="8" HorizontalAlignment="Center" Margin="0,10,0,0"></TextBlock>
                <Button x:Name="Concat" Content="🔗" Foreground="White" FontSize="15" Padding="0,0,0,0" Height="40" Width="40" BorderThickness="0" Background="#232425" ToolTip="一键合并.txt文件(按照导入顺序)" Click="Concat_Click" Margin="0,10,0,0"></Button>
                
            </StackPanel>
        </Border>
        <Border Grid.Column="2" Grid.Row="1"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#434343">
            <Border Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="1"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#232425" Margin="20,20,20,20" CornerRadius="10">
                <ScrollViewer Margin="5,5,5,70">
                    <WrapPanel x:Name="SelectedDocumentShower" Orientation="Horizontal" x:FieldModifier="public">

                    </WrapPanel>
                </ScrollViewer>
                
            </Border>
        </Border>
        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="3" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left">
            <TextBlock Text="File Progressing 2026" Foreground="#FFFFFF" FontSize="15"  VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0" Width="180"></TextBlock>
            <Button x:Name="Document" Content="文件" Foreground="#FFFFFF" FontSize="10"  VerticalAlignment="Center"  Width="60" Height="30" Margin="10,0,0,0" Background="#232425" BorderThickness="0" Click="Document_Click"/>
            <Button x:Name="Help" Content="帮助" Foreground="#FFFFFF" FontSize="10"  VerticalAlignment="Center"  Width="60" Height="30" Margin="10,0,0,0" Background="#232425" BorderThickness="0" Click="Help_Click"/>
            <Button x:Name="Settings" Content="设置" Foreground="#FFFFFF" FontSize="10"  VerticalAlignment="Center"  Width="60" Height="30" Margin="10,0,0,0" Background="#232425" BorderThickness="0" Click="Settings_Click"/>
            <Button x:Name="Edit" Content="编辑" Foreground="#FFFFFF" FontSize="10"  VerticalAlignment="Center"  Width="60" Height="30" Margin="10,0,0,0" Background="#232425" BorderThickness="0" Click="Edit_Click"/>

        </StackPanel>
        
        <Button x:Name="CloseWindow" Content="❌" Foreground="#FFFFFF" FontSize="10" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Width="60" Height="30" Margin="0,0,20,0" Background="#232425" BorderThickness="0" Click="CloseWindow_Click"/>
        
    </Grid>
</Window>
