<Window x:Class="FileProgressing2026.RenameSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileProgressing2026"
        mc:Ignorable="d"
        Title="File Progressing 2026 - 选择模板..." Height="450" Width="800"
        ResizeMode="NoResize"
        Background="#232425"
        
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Foreground="White" Grid.Row="0" Text="选择预设模板 或 自定义" FontSize="30" Margin="20,20,0,0" ></TextBlock>
        <TextBlock Foreground="White" Grid.Row="0" Text="🧩" Grid.RowSpan="2" FontSize="100" HorizontalAlignment="Right" Margin="0,30,30,0" ></TextBlock>
        <Border Background="#2D2D2D" Grid.Row="1" Margin="20,20,200,50" CornerRadius="10">
            <ScrollViewer HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,10,10,10">
                <StackPanel Orientation="Vertical">
                    <Button x:Name="TN" Content="预设 : 修改时间-文件名" BorderThickness="0" Background="#434343" Foreground="White" Margin="10,5,10,10" Click="TN_Click"></Button>
                    <Button x:Name = "TNI" Content="预设 : 修改时间-文件名-文件序次" BorderThickness="0" Background="#434343" Foreground="White" Margin="10,5,10,10" Click="TNI_Click"></Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Button x:Name="Confirm" Content="操作" BorderThickness="0" Background="#434343" Foreground="White" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Click="Confirm_Click" Width="80" Height="30" Margin="0,0,20,10"></Button>
        
    </Grid>
</Window>
