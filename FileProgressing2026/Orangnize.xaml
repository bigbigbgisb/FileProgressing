<Window x:Class="FileProgressing2026.Orangnize"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileProgressing2026"
        mc:Ignorable="d"
        Title="File Flow 2026 2026 - 整理文件" Height="450" Width="800"
        Background="#232425"
        ResizeMode="NoResize"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Foreground="White" Grid.Row="0" Text="选择预设模板 或 自定义" FontSize="30" Margin="20,20,0,0" ></TextBlock>
        <TextBlock Foreground="White" Grid.Row="0" Text="可多选" FontSize="15" Margin="20,60,0,0" ></TextBlock>
        <TextBlock Foreground="White" Grid.Row="0" Text="🧹" Grid.RowSpan="2" FontSize="100" HorizontalAlignment="Right" Margin="0,30,30,0" ></TextBlock>
        <Border x:Name="LightBlack" Background="#434343" Width="0" Height="0" Visibility="Collapsed"></Border>
        <Border x:Name="Bg" Background="#2D2D2D" Grid.Row="1" Margin="20,20,200,50" CornerRadius="10">
            <ScrollViewer HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,10,10,10">
                <StackPanel Orientation="Vertical">
                    <Button x:Name= "Image" Content="预设 : .png,.jpg,.jpeg,.webp归于\image" BorderThickness="0" Background="#434343" Foreground="White" Margin="10,5,10,10" Click="Rule_Click"></Button>
                    <Button x:Name = "Document" Content="预设 : .docx,.doc,.xlsx,.pdf,.txt归于\document" BorderThickness="0" Background="#434343" Foreground="White" Margin="10,5,10,10" Click="Rule_Click"></Button>
                    <Button x:Name = "Code" Content="预设 : .py,.cs,.c,.cpp,.hpp,.h,.html,.js等归于\code" BorderThickness="0" Background="#434343" Foreground="White" Margin="10,5,10,10" Click="Rule_Click"></Button>
                    <Button x:Name = "Zip" Content="预设 : .zip,.7z,.rar归于\zip" BorderThickness="0" Background="#434343" Foreground="White" Margin="10,5,10,10" Click="Rule_Click"></Button>
                    <Button x:Name = "Video" Content="预设 : .mp4,.mpg,.mov等归于\video" BorderThickness="0" Background="#434343" Foreground="White" Margin="10,5,10,10" Click="Rule_Click"></Button>
                    <Button x:Name = "Audio" Content="预设 : .mp3,.wav,.m4a等归于\audio" BorderThickness="0" Background="#434343" Foreground="White" Margin="10,5,10,10" Click="Rule_Click"></Button>
                    <Button x:Name = "Exe" Content="预设 : .exe,.msi,.bat等归于\exe" BorderThickness="0" Background="#434343" Foreground="White" Margin="10,5,10,10" Click="Rule_Click"></Button>
                    
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Button x:Name="Confirm" Content="操作" BorderThickness="0" Background="#434343" Foreground="White" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Click="Confirm_Click" Width="80" Height="30" Margin="0,0,20,10"></Button>

    </Grid>
</Window>
